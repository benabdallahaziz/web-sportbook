# Copier ce fichier en .env pour modifier les valeurs par défaut
PORT=8088
HOST=localhost

# Base propre au microservice (créée automatiquement au démarrage)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/sportbook_stats

# Service Discovery
EUREKA_SERVER=http://localhost:8761/eureka

# Broker de messages
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Service appelé en REST (résolu via Eureka, sinon URL de secours)
TOURNAMENT_SERVICE=tournament-events-service
TOURNAMENT_FALLBACK_URL=http://localhost:8086
